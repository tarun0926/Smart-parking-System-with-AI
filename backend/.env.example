# ─────────────────────────────────────────────────
# SmartPark AI — Backend Environment Configuration
# Copy to .env and fill in your real values
# ─────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas (production) or local MongoDB
# Get your URI from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartpark_ai?retryWrites=true&w=majority

# JWT — generate a strong 64-char secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRE=30d

# AI Service URL (Python FastAPI)
# In production: the URL where your AI service is deployed
AI_SERVICE_URL=https://your-ai-service.onrender.com

# Frontend origin for CORS (production domain)
CLIENT_ORIGIN=https://your-frontend.vercel.app
